diff --git a/mujoco_playground/_src/modern_backend.py b/mujoco_playground/_src/modern_backend.py
new file mode 100644
index 0000000..45cae10
--- /dev/null
+++ b/mujoco_playground/_src/modern_backend.py
@@ -0,0 +1,44 @@
+"""MJX-Warp rendering and fixed-size contact queries for the cuboid tasks."""
+import jax
+import jax.numpy as jp
+from mujoco import mjx
+
+_PAIRS = [(a, b) for a in ('box', 'floor')
+          for b in ('left_finger_pad', 'right_finger_pad', 'hand_capsule')]
+
+
+def add_contact_sensors(xml):
+    # mindist preserves the original minimum-contact-distance < 0 predicate.
+    sensors = ''.join(
+        f'<contact name="research_contact_{i}" geom1="{a}" geom2="{b}" '
+        'data="dist" reduce="mindist" num="1"/>'
+        for i, (a, b) in enumerate(_PAIRS))
+    return xml.replace('</mujoco>', '<sensor>' + sensors + '</sensor></mujoco>')
+
+
+def contact_sensor_addresses(model):
+    return {tuple(sorted((model.geom(a).id, model.geom(b).id))):
+            int(model.sensor(f'research_contact_{i}').adr[0])
+            for i, (a, b) in enumerate(_PAIRS)}
+
+
+class WarpRenderer:
+    def __init__(self, model, config):
+        if config.impl != 'warp' or jax.default_backend() != 'gpu':
+            raise RuntimeError('Vision requires --impl=warp and a CUDA JAX device.')
+        vc = config.vision_config
